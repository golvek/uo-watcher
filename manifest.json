{
  "manifest_version": 3,
  "name": "UO Watcher",
  "version": "1.0",
  "description": "Draggable countdown timer overlay for internal review tools. Track tasks, banking time, and daily totals.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UO Watcher"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://review.intern.facebook.com/intern/review/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
